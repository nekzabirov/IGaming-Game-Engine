# ===========================================
# casino-engine Configuration
# ===========================================

# --- Server Ports ---
HTTP_PORT=8080
GRPC_PORT=5050

# --- Database (PostgreSQL) ---
# Base URL without DB name. Casino DB ("casino") is created by /app/bin/db-migrate.
DB_URL=jdbc:postgresql://localhost:5432
DB_USERNAME=user
DB_PASSWORD=password

# --- Wallet Service (gRPC) ---

# --- GameHub (gRPC) ---
# The only vendor integration point — casino-engine talks to no aggregator directly any more.
GAMEHUB_GRPC_HOST=localhost
GAMEHUB_GRPC_PORT=50051
GAMEHUB_OPERATOR_ID=
GAMEHUB_OPERATOR_KEY=
# true for a local GameHub over loopback; prod is TLS behind an ALB.
GAMEHUB_GRPC_PLAINTEXT=true

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379


# --- RabbitMQ ---
# Exchange name is hardcoded as "casino-engine" — see infrastructure/rabbitmq/RabbitMqConstants.kt.
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest
# Set to true for AWS Amazon MQ / any TLS-only broker.
# Make sure RABBIT_PORT matches the broker's TLS port (usually 5671).
RABBIT_TLS=false
