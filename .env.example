# ===========================================
# casino-engine Configuration
# ===========================================

# --- Server Ports ---
HTTP_PORT=8080
GRPC_PORT=5050

# --- Database (PostgreSQL) ---
# Base URL without DB name; DATABASE_NAME is appended. bin/db-migrate creates the database.
DB_URL=jdbc:postgresql://localhost:5432
DATABASE_NAME=casino
DB_USERNAME=user
DB_PASSWORD=password
DB_POOL_SIZE=10

# --- pam-engine (player account, wallet ledger, currencies) ---
PAM_GRPC_HOST=localhost
PAM_GRPC_PORT=9090

# --- GameHub (gRPC) ---
# The only vendor integration point — casino-engine talks to no aggregator directly.
GAMEHUB_GRPC_HOST=localhost
GAMEHUB_GRPC_PORT=50051
GAMEHUB_OPERATOR_ID=
GAMEHUB_OPERATOR_KEY=
# true for a local GameHub over loopback; prod is TLS behind an ALB.
GAMEHUB_GRPC_PLAINTEXT=true

# --- Redis (player limits) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RabbitMQ (events) ---
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest
# Set to true for AWS Amazon MQ / any TLS-only broker (and RABBIT_PORT=5671).
RABBIT_TLS=false
EVENT_EXCHANGE=crm.exchange

# --- Who pays a free round's win: this engine (true) or the promotion's owner (false) ---
FREESPIN_TO_PAYOUT=true
